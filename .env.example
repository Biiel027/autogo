# ==============================================================================
# AutoGO - Configurações de Ambiente (Supabase & n8n)
# ==============================================================================

# Supabase: Acesse Project Settings > API no console do Supabase
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# n8n: URL do Webhook do fluxo de IA para atendimento Web
VITE_N8N_WEBHOOK_URL=https://your-n8n-domain.com/webhook/autogo-ai-agent
